{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "纯钧",
  "version": "0.1.0",
  "identifier": "com.shenbing.chunjun",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "纯钧 · 图片处理",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#F7F7F3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../assets/brand/raster/app-icon-32.png",
      "../assets/brand/raster/app-icon-128.png",
      "../assets/brand/raster/app-icon-256.png",
      "../assets/brand/raster/app-icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
