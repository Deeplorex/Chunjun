{
  "name": "chunjun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:build": "tauri build --no-bundle",
    "desktop:package": "tauri build --bundles nsis",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/check-changes.test.mjs",
    "native:check": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "change:check": "node scripts/check-changes.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm native:check && pnpm native:test && pnpm build && pnpm change:check",
    "quality:full": "pnpm quality && pnpm audit --prod && cargo audit --file src-tauri/Cargo.lock",
    "release:preflight": "pnpm quality:full && tauri info"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
